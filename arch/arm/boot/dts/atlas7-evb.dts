/dts-v1/;

/include/ "atlas7.dtsi"

/ {
	model = "CSR SiRFatlas7 Evaluation Board";
	compatible = "sirf,atlas7-cb", "sirf,atlas7";

	chosen {
		/* bootargs = "console=ttySiRF1,115200 earlyprintk lpj=7970816 initrd=0x43008000,0x500000"; */
		bootargs = "console=ttySiRF1,115200 earlyprintk lpj=7970816 ";
	};

	memory {
		device_type = "memory";
		reg = <0x40000000 0x02000000>; /* 32 or 512M for PXP */
	};

	axi {
		peri-iobg {
			pci-iobg {
				sd2: sdhci@14200000 {
					status = "okay";
				};
			};
		};
	};
};
