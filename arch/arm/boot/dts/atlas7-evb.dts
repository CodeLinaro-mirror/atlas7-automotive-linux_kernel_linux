/dts-v1/;

/include/ "atlas7.dtsi"

/ {
	model = "CSR SiRFatlas7 Evaluation Board";
	compatible = "sirf,atlas7-cb", "sirf,atlas7";

	chosen {
		/* bootargs = "console=ttySiRF1,115200 earlyprintk lpj=7970816
				initrd=0x43008000,0x500000"; */
		bootargs = "console=ttySiRF1,115200 earlyprintk";
	};

	memory {
		device_type = "memory";
		reg = <0x40000000 0x20000000>; /* 512M for PXP */
	};

	sound-internal-audio {
		compatible = "simple-audio-card";
		simple-audio-card,routing =
			"Headphone Jack", "LOUT0",
			"LIN0", "Line In Jack";
		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Line", "Line In Jack";
		simple-audio-card,codec {
			sound-dai = <&atlas7_codec>;
		};
		simple-audio-card,cpu {
			sound-dai = <&atlas7_iacc>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ipc_mem0: ns_m3_mem@4fd00000 {
			compatible = "sirf,reserved-memory";
			reg = <0x4FD00000 0x10000>;
		};

		ipc_mem1: ns_kal_mem@4fd10000 {
			compatible = "sirf,reserved-memory";
			reg = <0x4FD10000 0x10000>;
		};

		vpp_reserved: vpp_mem@5e800000 {
			compatible = "sirf,reserved-memory";
			reg = <0x5e800000 0x800000>;
		};

		nanddisk_reserved: nanddisk@46000000 {
			reg = <0x46000000 0x200000>;
			no-map;
		};

		multimedia_reserved: multimedia@58800000 {
			reg = <0x58800000 0x6000000>;
			no-map;
		};

		cm3_reserved: cm3@4fe00000 {
			reg = <0x4fe00000 0x100000>;
			no-map;
		};
	};

	bt_sco: bt_sco@0 {
		#sound-dai-cells = <0>;
		compatible = "bt-sco";
		status = "okay";
	};

	sirf-bt-sco {
		compatible = "simple-audio-card";
		simple-audio-card,format = "dsp_a";
		simple-audio-card,cpu {
			sound-dai = <&usp3>;
		};
		simple-audio-card,codec {
			sound-dai = <&bt_sco>;
			bitclock-master;
			frame-master;
		};
	};

	noc {
		audiom {
			timer@10dc0000 {
				status = "okay";
			};

			timerb@10dc8000 {
				status = "disabled";
			};

			usp1: usp@10d30000 {
				status = "disabled";
				compatible = "sirf,prima2-usp-pcm";
				#sound-dai-cells = <0>;
				pinctrl-names = "default";
				pinctrl-0 = <&audio_uart1_pmx>;
			};

			usp2: usp@10d40000 {
				status = "disabled";
				compatible = "sirf,atlas7-usp-spi";
				pinctrl-0 = <&audio_uart2_pmx0>;
				pinctrl-names = "default";
				spi@0 {
					compatible = "spidev";
					reg = <0>;
					spi-max-frequency = <1000000>;
				};
			};

			pulsec@10d90000 {
				status = "disabled";
				pinctrl-names = "default";
				pinctrl-0 = <&ps_pmx>;
			};

			usp2: usp@10d40000 {
				status = "disabled";
				compatible = "sirf,atlas7-usp-uart";
				pinctrl-names = "default";
				pinctrl-0 = <&audio_uart2_pmx0>;
				fifosize = <512>;
			};

			vip0@10db0000 {
				status = "okay";
				port {
					#address-cells = <1>;
					#size-cells = <0>;
					vip0_0: endpoint@0 {
						reg = <0>;
						hsync-active = <0>;
						vsync-active = <0>;
						remote-endpoint = <&cvd_1>;
					};
				};
			};

			cvd@10db2000 {
				compatible = "sirf,cvd";
					input-number = <2>;
					inputs = <&cvbs0 &cvbs1>;
					cvbs0: cvbs@0 {
						input-name = "camera";
						input-id = <0>;
					};
					cvbs1: cvbs@1 {
						input-name = "dvd";
						input-id = <1>;
					};
					port {
						cvd_1: endpoint {
						remote-endpoint = <&vip0_0>;
					};
				};
			};
		};

		mediam {
			nand@17050000 {
				memory-region = <&nanddisk_reserved>;
			};

			multimedia@15000000 {
				memory-region = <&multimedia_reserved>;
			};

			sdhci@16000000 {
				pinctrl-names = "default";
				pinctrl-0 = <&sd0_pmx>;
				status = "okay";
			};

			i2c0: i2c@17020000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&i2c0_pmx>;
				clock-frequency = <40000>;

				gpio_3: i2c_gpio_expander@20{
					#gpio-cells = <2>;
					#interrupt-cells = <2>;
					compatible = "semtech,sx1506q";
					reg = <0x20>;
					interrupt-parent = <&gpio_1>;
					interrupts = <7 4>;
					int-gpios = <&gpio_1 7 0>;
					pulldn_ena = <0xff>;

					gpio-controller;
					interrupt-controller;
				};

				ft5x06@38{
					compatible = "focaltech,ft5x06";
					interrupt-parent = <&gpio_3>;
					interrupts = <3 0x03>;
					reg = <0x38>;
				};
			};
		};

		vdifm {
			sdhci@14200000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&sd2_pmx0>;
			};

			sdhci@14500000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&sd5_pmx>;
			};

			sdhci@14700000 {
				status = "okay";
			};
		};

		gnssm {
			uart1: uart@18020000 {
				status = "okay";
			};

			uart0: uart@18010000 {
				status = "okay";
				pinctrl-0 = <&uart0_pmx>;
				pinctrl-names = "default";
				sirf,uart-has-rtscts;
                        };

			uart2: uart@18030000 {
				status = "disabled";
				pinctrl-0 = <&uart2_pmx>;
				pinctrl-names = "default";
			};

			uart3: uart@18040000 {
				status = "okay";
				pinctrl-0 = <&uart3_nopause_pmx0>;
				pinctrl-names = "default";
			};

			uart4: uart@18050000 {
				status = "okay";
				pinctrl-0 = <&uart4_pmx1>;
				pinctrl-names = "default";
			};

			uart5: uart@18060000 {
				status = "okay";
			};

			spi1: spi@18200000 {
				status = "okay";
				pinctrl-0 = <&sp1_spi_pmx>;
				pinctrl-names = "default";
				spiflash: macronix@0{
					status = "okay";
					compatible = "macronix,mx25l6405d";
					reg = <0>;
					spi-max-frequency = <37500000>;
					spi-cpha;
					spi-cpol;
					#address-cells = <1>;
					#size-cells = <1>;
					partitions@0 {
						label = "myspiboot";
						reg = <0x0 0x800000>;
					};
				};
			};
			gps-power {
				   status = "okay";
				   pinctrl-names = "default";
				   pinctrl-0 = <&gn_trg_spi_pmx0 &gn_trg_pmx0
						   &gn_trg_shutdown_pmx0>;
			};
		};

		btm {
			usp3: usp@11001000 {
				status = "okay";
				#sound-dai-cells = <0>;
			};

			uart6: uart@11000000 {
				status = "okay";
				sirf,uart-has-rtscts;
			};
		};

		rtcm {
			qspi: flash@188B0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&sp0_qspi_pmx>;
				clock-rate = <20000000>;        /* 20MHz */
			};
		};

		ipc@13240000 {
			ns_m3_rproc@0 {
				memory-region = <&ipc_mem0>;
				status = "okay";
			};

			ns_m3_rproc@1 {
				status = "disabled";
			};

			ns_kal_rproc@0 {
				memory-region = <&ipc_mem1>;
				status = "okay";
			};

			ns_kal_rproc@1 {
				status = "disabled";
			};
		};

		disp-iobg {
			lcd@13100000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&ld_ldd_pmx &ld_ldd_fck_pmx
					&ld_ldd_lck_pmx>;
			};
			vpp@13110000 {
				memory-region = <&vpp_reserved>;
			};

			lvds@10e10000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&lvds_analog_pmx>;
				/* set to SYN or SLAVE for lvds panel */
				lvds-mode = "SYN";
				/* set lvds data src,0 for LCDC0,1 for LCDC1*/
				lvds-source = <0>;
			};
		};

		display0: display@0 {
			compatible = "lvds-panel";
			source = "lvds.0";

			bl-gpios = <&gpio_1 63 0>;
			data-lines  = <24>;

			display-timings {
				native-mode = <&timing0>;
				timing0: timing0 {
					clock-frequency = <60000000>;
					hactive = <1024>;
					vactive = <600>;
					hfront-porch = <220>;
					hback-porch = <100>;
					hsync-len = <1>;
					vback-porch = <10>;
					vfront-porch = <25>;
					vsync-len = <1>;
					hsync-active = <0>;
					vsync-active = <0>;
					de-active = <1>;
					pixelclk-active = <1>;
				};
			};
		};
	};
};
