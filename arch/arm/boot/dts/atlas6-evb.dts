/dts-v1/;

/include/ "atlas6.dtsi"

/ {
	model = "CSR SiRFatlas6 Evaluation Board";
	compatible = "sirf,atlas6-cb", "sirf,atlas6";

	memory {
		reg = <0x00000000 0x20000000>;
	};

	axi {
		peri-iobg {
			uart@b0060000 {
				pinctrl-names = "default";
				pinctrl-0 = <&uart1_pins_a>;
			};
			audio@b0040000 {
				hp-pa-gpios = <&gpio 44 0>;
				spk-pa-gpios = <&gpio 46 0>;
				hp-switch-gpios = <&gpio 45 0>;
			};
			vip@b00C0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&vip_pins_a>;
				power-gpio = <&gpio 9 0>;
				reset-gpio = <&gpio 12 0>;
			};
			spi@b00d0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&spi0_pins_a>;
				spi@0 {
					compatible = "spidev";
					reg = <0>;
					spi-max-frequency = <1000000>;
				};
			};
			spi@b0170000 {
				pinctrl-names = "default";
				pinctrl-0 = <&spi1_pins_a>;
			};
			i2c0: i2c@b00e0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&i2c0_pins_a>;
				lcd@40 {
					compatible = "sirf,lcd";
					reg = <0x40>;
				};
			};
			pci-iobg {
				sd0: sdhci@56000000 {
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <&sdmmc0_pins_a>;
				};
				sd2: sdhci@56200000 {
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <&sdmmc2_pins_a>;
				};
			};
			tsc {
				compatible = "sirf,prima2-tsc";
				interrupts = <33>;
				reset-bit = <32>;
				default-parameter = <&touch>;
			};
		};
		disp-iobg {
			lcd@90010000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&lcd_24pins_a>;
				/*layer enable info,default only enable layer1 */
				layer-ctrl = <0x00000001>;
			};
		};
	};
	display: display@0 {
	    panels {
		panel0: panel@0 {
			panel-name = "Innolux TFT";
			hactive = <800>;
			vactive = <480>;
			left-margin = <20>;
			right-margin = <234>;
			upper-margin = <3>;
			lower-margin = <41>;
			hsync-len = <3>;
			vsync-len = <2>;
			pixclock = <33264000>;
			sync = <3>;
			timing = <0x88>;
			};
	    };
	};
	touch: touch@0 {
		x_min = <0x0>;
		x_max = <0xfff>;
		y_min = <0x0>;
		y_max = <0xfff>;
		debounce_rep = <0x01>;
		debounce_max = <0x03>;
		debounce_tol = <0x30>;
		interval = <10>;
	};

};
