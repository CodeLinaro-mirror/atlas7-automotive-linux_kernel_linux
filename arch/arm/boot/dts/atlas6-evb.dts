/dts-v1/;

/include/ "atlas6.dtsi"

/ {
	model = "CSR SiRFatlas6 Evaluation Board";
	compatible = "sirf,atlas6-cb", "sirf,atlas6";

	memory {
		reg = <0x00000000 0x20000000>;
	};
	sound {
		compatible = "sirf,sirf-inner";
		hp-pa-gpios = <&gpio 44 0>;
		spk-pa-gpios = <&gpio 46 0>;
		hp-switch-gpios = <&gpio 45 0>;
	};

	bt-sco {
		compatible = "bt-sco";
	};
	sirf-bt-sco {
		compatible = "sirf,sirf-bt-sco";
		codec-clock-frame-master = <1>;
	};
	sirf-hdmi-codec {
		compatible = "sirf,hdmi-codec";
	};
	sirf-hdmi {
		compatible = "sirf,hdmi-card";
	};
	sirf-backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 3 50000 90 0>;
		sirf-pwm-step-mode;
		sirf-pwm-step-mode-params = <30 100000000>;
		sirf-pwm-bklscaling-params = <50000 3125
					50000 6250
					50000 9375
					50000 12500
					50000 15625
					50000 18750
					50000 21875
					50000 25000
					50000 28125
					50000 31250
					50000 34375
					50000 37500
					50000 40625
					50000 43750
					50000 46875
					50000 50000>;
		brightness-levels = <0 4 16 32 64 128 254 255>;
		default-brightness-level = <6>;
	};
	axi {
		peri-iobg {
			uart@b0050000 {
				pinctrl-names = "default";
				pinctrl-0 = <&uart0_pins_a>;
				hw_flow_ctrl;
			};
			uart@b0060000 {
				pinctrl-names = "default";
				pinctrl-0 = <&uart1_pins_a>;
			};
			uart@b0070000 {
				pinctrl-names = "default";
				pinctrl-0 = <&uart2_pins_a>;
				hw_flow_ctrl;
			};
			i2s@b0040000 {
				pinctrl-names = "default";
				pinctrl-0 = <&i2s_pins_a>;
			};
			vip@b00C0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&vip_pins_a>;
				power-gpio = <&gpio 9 0>;
				reset-gpio = <&gpio 12 0>;
				rearview-gpio = <&gpio 4 0>;
			};
			spi@b00d0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&spi0_pins_a>;
				spi@0 {
					compatible = "spidev";
					reg = <0>;
					spi-max-frequency = <1000000>;
				};
			};
			spi@b0170000 {
				pinctrl-names = "default";
				pinctrl-0 = <&spi1_pins_a>;
			};
			usp@b0080000 {
				compatible = "sirf,prima2-usp-pcm", "sirf,prima2-usp", "sirf,prima2-usp-uart";
				pinctrl-names = "default";
				pinctrl-0 = <&usp0_pins_a>;
			};
			usp@b0090000 {
				compatible = "sirf,prima2-usp-uart";
				pinctrl-names = "default";
				pinctrl-0 = <&usp1_pins_a>;
			};
			i2c0: i2c@b00e0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&i2c0_pins_a>;
				lcd@40 {
					compatible = "sirf,lcd";
					reg = <0x40>;
				};
			};
			pci-iobg {
				sd0: sdhci@56000000 {
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <&sdmmc0_pins_a>;
				};
				sd2: sdhci@56200000 {
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <&sdmmc2_pins_a>;
				};
			};
			tsc {
				compatible = "sirf,prima2-tsc";
				interrupts = <33>;
				reset-bit = <32>;
				default-parameter = <&touch>;
			};
		};
		disp-iobg {
			lcd@90010000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&lcd_24pins_a>;
				/*layer enable info,default only enable layer1 */
				layer-ctrl = <0x0000000b>;
			};
		};
	};
	display: display@0 {
	    panels {
		panel0: panel@0 {
			panel-name = "Innolux TFT";
			hactive = <800>;
			vactive = <480>;
			left-margin = <20>;
			right-margin = <234>;
			upper-margin = <3>;
			lower-margin = <41>;
			hsync-len = <3>;
			vsync-len = <2>;
			pixclock = <33264000>;
			sync = <3>;
			timing = <0x88>;
			};
	    };
	};
	touch: touch@0 {
		x_min = <0x0>;
		x_max = <0xfff>;
		y_min = <0x0>;
		y_max = <0xfff>;
		debounce_rep = <0x01>;
		debounce_max = <0x03>;
		debounce_tol = <0x30>;
		interval = <10>;
	};

};
