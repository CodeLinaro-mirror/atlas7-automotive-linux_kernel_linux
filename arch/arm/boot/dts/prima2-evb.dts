/dts-v1/;

/include/ "prima2.dtsi"

/ {
	model = "CSR SiRFprimaII Evaluation Board";
	compatible = "sirf,prima2", "sirf,prima2-cb";

	memory {
		reg = <0x00000000 0x20000000>;
	};

	axi {
		peri-iobg {
			uart@b0060000 {
				pinctrl-names = "default";
				pinctrl-0 = <&uart1_pins_a>;
			};
			vip@b00C0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&vip_pins_a>;
				power-gpio = <&gpio 9 0>;
				reset-gpio = <&gpio 12 0>;
			};
			spi@b00d0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&spi0_pins_a>;
				spi@0 {
					compatible = "spidev";
					reg = <0>;
					spi-max-frequency = <1000000>;
				};
			};
			spi@b0170000 {
				pinctrl-names = "default";
				pinctrl-0 = <&spi1_pins_a>;
			};
			i2c0: i2c@b00e0000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&i2c0_pins_a>;
				lcd@40{
					compatible = "sirf,lcd";
					reg = <0x40>;
				};

			};
		};
                disp-iobg {
                      lcd@90010000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&lcd_24pins_a>;
				/*layer enable info,default only enable layer1 */
				layer-ctrl = <0x000000f>;
		      };
		};
	};

	display: display@0 {
		panels {
			panel0: panel@0 {
				panel-name = "Samsung WVGA";
				hactive = <800>;
				vactive = <480>;
				left-margin = <13>;
				right-margin = <8>;
				upper-margin = <5>;
				lower-margin = <5>;
				hsync-len = <3>;
				vsync-len = <3>;
				pixclock = <24000000>;
				sync = <3>;
				timing = <0xA8>;
			};
			panel1: panel@1 {
				panel-name = "Toshiba WVGA";
				hactive = <800>;
				vactive = <480>;
				left-margin = <69>;
				right-margin = <167>;
				upper-margin = <33>;
				lower-margin = <11>;
				hsync-len = <20>;
				vsync-len = <1>;
				pixclock = <33000000>;
				sync = <3>;
				timing = <0xA8>;
			};
		};
	};
};
