/ {
	bt_sco_a2dp: bt-sco-a2dp {
		#sound-dai-cells = <0>;
		compatible = "bt-sco-a2dp";
		status = "okay";
	};
/*
 * FIXME
 * Now pcm interface is used in android while i2s interface is used in linux
 * It is necessay to drop this workaround after i2s interface is used in android
 */
	sirf-bt-sco-a2dp {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,cpu {
			sound-dai = <&usp3>;
		};
		simple-audio-card,codec {
			sound-dai = <&bt_sco_a2dp>;
			bitclock-master;
			frame-master;
		};
	};
	noc {
		vdifm {
			sdhci@14700000 {
				status = "okay";
			};
		};

		btm {
			usp3: usp@11001000 {
				status = "okay";
				#sound-dai-cells = <0>;
			};

			uart6: uart@11000000 {
				status = "okay";
				sirf,uart-has-rtscts;
			};
			a7ca_bt {
				compatible = "sirf,a7ca_bt";
				clocks = <&car 129>, <&car 137>, <&car 133>;
				clock-names="a7ca_btss","a7ca_btslow",
				"a7ca_io";
			};
		};
		audiom {
			usp1: usp@10d30000 {
				status = "okay";
				compatible = "sirf,atlas7-usp-spi";
				pinctrl-names = "default";
				pinctrl-0 = <&audio_uart1_pmx>;
				#address-cells = <1>;
				#size-cells = <0>;
				spidev@0 {
					compatible = "spidev";
					reg = <0>;
					spi-max-frequency = <1000000>;
				};
			};
		};
	};
};
