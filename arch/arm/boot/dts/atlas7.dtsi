/include/ "skeleton.dtsi"
/ {
	compatible = "sirf,atlas7";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
		};
		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <1>;
		};
	};

	noc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x10000000 0x10000000 0xc0000000>;

		gic: interrupt-controller@10301000 {
			compatible = "arm,cortex-a9-gic";
			interrupt-controller;
			#interrupt-cells = <3>;
			reg = <0x10301000 0x1000>,
			     <0x10302000 0x0100>;
		};

		ipc@13240000 {
			compatible = "sirf,atlas7-ipc";
			ranges = <0x13240000 0x13240000 0x00010000>;
			#address-cells = <1>;
			#size-cells = <1>;
		};


		dramfw {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x10830000 0x10830000 0x18000>;
			dramfw@10820000 {
				compatible = "sirf,nocfw-dramfw";
				reg = <0x10830000 0x18000>;
			};
		};

		spramfw {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x10250000 0x10250000 0x3000>;
			spramfw@10820000 {
				compatible = "sirf,nocfw-spramfw";
				reg = <0x10250000 0x3000>;
			};
		};

		cpum {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x10200000 0x10200000 0x3000>;
			cpum@10200000 {
				compatible = "sirf,nocfw-cpum";
				reg = <0x10200000 0x3000>;
			};
		};
		cgum {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x18641000 0x18641000 0x3000>,
					 <0x18620000 0x18620000 0x1000>;

			cgum@18641000 {
				compatible = "sirf,nocfw-cgum";
				reg = <0x18641000 0x3000>;
			};
			clks: clock-controller@18620000 {
				compatible = "sirf,atlas7-clkc";
				reg = <0x18620000 0x1000>;
				#clock-cells = <1>;
			};

			vclks: clock-controller {
				compatible = "sirf,virtio-clkc";
				#clock-cells = <1>;
				clock_num = <142>;
				clocks = <&clks 0>, <&clks 1>, <&clks 2>, <&clks 3>,
					<&clks 4>, <&clks 5>, <&clks 6>, <&clks 7>,
					<&clks 8>, <&clks 9>, <&clks 10>, <&clks 11>,
					<&clks 12>, <&clks 13>, <&clks 14>, <&clks 15>,
					<&clks 16>, <&clks 17>, <&clks 18>, <&clks 19>,
					<&clks 20>, <&clks 21>, <&clks 22>, <&clks 23>,
					<&clks 24>, <&clks 25>, <&clks 26>, <&clks 27>,
					<&clks 28>, <&clks 29>, <&clks 30>, <&clks 31>,
					<&clks 32>, <&clks 33>, <&clks 34>, <&clks 35>,
					<&clks 36>, <&clks 37>, <&clks 38>, <&clks 39>,
					<&clks 40>, <&clks 41>, <&clks 42>, <&clks 43>,
					<&clks 44>, <&clks 45>, <&clks 46>, <&clks 47>,
					<&clks 48>, <&clks 49>, <&clks 50>, <&clks 51>,
					<&clks 52>, <&clks 53>, <&clks 54>, <&clks 55>,
					<&clks 56>, <&clks 57>, <&clks 58>, <&clks 59>,
					<&clks 60>, <&clks 61>, <&clks 62>, <&clks 63>,
					<&clks 64>, <&clks 65>, <&clks 66>, <&clks 67>,
					<&clks 68>, <&clks 69>, <&clks 70>, <&clks 71>,
					<&clks 72>, <&clks 73>, <&clks 74>, <&clks 75>,
					<&clks 76>, <&clks 77>, <&clks 78>, <&clks 79>,
					<&clks 80>, <&clks 81>, <&clks 82>, <&clks 83>,
					<&clks 84>, <&clks 85>, <&clks 86>, <&clks 87>,
					<&clks 88>, <&clks 89>, <&clks 90>, <&clks 91>,
					<&clks 92>, <&clks 93>, <&clks 94>, <&clks 95>,
					<&clks 96>, <&clks 97>, <&clks 98>, <&clks 99>,
					<&clks 100>, <&clks 101>, <&clks 102>, <&clks 103>,
					<&clks 104>, <&clks 105>, <&clks 106>, <&clks 107>,
					<&clks 108>, <&clks 109>, <&clks 110>, <&clks 111>,
					<&clks 112>, <&clks 113>, <&clks 114>, <&clks 115>,
					<&clks 116>, <&clks 117>, <&clks 118>, <&clks 119>,
					<&clks 120>, <&clks 121>, <&clks 122>, <&clks 123>,
					<&clks 124>, <&clks 125>, <&clks 126>, <&clks 127>,
					<&clks 128>, <&clks 129>, <&clks 130>, <&clks 131>,
					<&clks 132>, <&clks 133>, <&clks 134>, <&clks 135>,
					<&clks 136>, <&clks 137>, <&clks 138>, <&clks 139>,
					<&clks 140>, <&clks 141>;
			};
		};
		gnssm {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x18000000 0x18000000 0x0000ffff>,
				<0x18010000 0x18010000 0x1000>,
				<0x18020000 0x18020000 0x1000>,
				<0x18100000 0x18100000 0x3000>;

			dmac0: dma-controller@18000000 {
				cell-index = <0>;
				compatible = "sirf,atlas7-dmac";
				reg = <0x18000000 0x1000>;
				interrupts = <0 12 0>;
				#clocks = <&clks 24>;
				#dma-cells = <1>;
				#dma-channels = <16>;
			};
			gnssmfw@0x18100000 {
				compatible = "sirf,nocfw-gnssm";
				reg = <0x18100000 0x3000>;
			};

			uart0: uart@18010000 {
					cell-index = <0>;
					compatible = "sirf,marco-uart";
					reg = <0x18010000 0x1000>;
					interrupts = <0 17 0>;
					clocks = <&clks 95>;
					fifosize = <32>;
			};
			uart1: uart@18020000 {
				cell-index = <1>;
				compatible = "sirf,marco-uart";
				reg = <0x18020000 0x1000>;
				interrupts = <0 18 0>;
				clocks = <&clks 95>;
				fifosize = <32>;
			};
		};


		gpum {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x13000000 0x13000000 0x3000>;
			gpum@0x13000000 {
				compatible = "sirf,nocfw-gpum";
				reg = <0x13000000 0x3000>;
			};
		};

		mediam {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x16000000 0x16000000 0x00200000>,
				 <0x170A0000 0x170A0000 0x3000>;
			mediam@170A0000 {
				compatible = "sirf,nocfw-mediam";
				reg = <0x170A0000 0x3000>;
			};
                        sd0: sdhci@16000000 {
				cell-index = <0>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x16000000 0x100000>;
				interrupts = <0 38 0>;
				clocks = <&clks 116>, <&clks 118>;
				clock-names = "core", "iface";
				wp-inverted;
				broken-cd;
				non-removable;
				status = "disabled";
				bus-width = <8>;
                        };
                        sd1: sdhci@16100000 {
				cell-index = <1>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x16000000 0x100000>;
				interrupts = <0 38 0>;
				clocks = <&clks 116>, <&clks 118>;
				clock-names = "core", "iface";
				non-removable;
				status = "disabled";
				bus-width = <8>;
                        };
		};

		vdifm {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x13290000 0x13290000 0x3000>,
                     <0x14200000 0x14200000 0x600000>;

			vdifm@13290000 {
				compatible = "sirf,nocfw-vdifm";
				reg = <0x13290000 0x3000>;
			};

			sd2: sdhci@14200000 {
				cell-index = <2>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x14200000 0x100000>;
				interrupts = <0 23 0>;
				clocks = <&clks 77>, <&clks 82>;
				clock-names = "core", "iface";
				wp-inverted;
				broken-cd;
				non-removable;
				status = "disabled";
				bus-width = <4>;
			};

			sd3: sdhci@14300000 {
				cell-index = <3>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x14200000 0x100000>;
				interrupts = <0 23 0>;
				clocks = <&clks 77>, <&clks 82>;
				clock-names = "core", "iface";
				status = "disabled";
				bus-width = <4>;
			};

			sd5: sdhci@14500000 {
				cell-index = <5>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x14500000 0x100000>;
				interrupts = <0 39 0>;
				clocks = <&clks 78>, <&clks 83>;
				clock-names = "core", "iface";
				status = "disabled";
				bus-width = <4>;
				loop-dma;
			};

			sd6: sdhci@14600000 {
				cell-index = <6>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x14600000 0x100000>;
				interrupts = <0 98 0>;
				clocks = <&clks 79>, <&clks 83>;
				clock-names = "core", "iface";
				status = "disabled";
				bus-width = <4>;
			};

			sd7: sdhci@14700000 {
				cell-index = <7>;
				compatible = "sirf,atlas7-sdhc";
				reg = <0x14700000 0x100000>;
				interrupts = <0 98 0>;
				clocks = <&clks 79>, <&clks 83>;
				clock-names = "core", "iface";
				status = "disabled";
				bus-width = <4>;
			};

		};

		audiom {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x10d50000 0x10d50000 0x0000ffff>,
			        <0x10d60000 0x10d60000 0x0000ffff>,
					<0x10ED0000 0x10ED0000 0x3000>,
					<0x10dc8000 0x10dc8000 0x1000>,
					<0x10dc0000 0x10dc0000 0x1000>;

			timer@10dc0000 {
				compatible = "sirf,marco-tick";
				reg = <0x10dc0000 0x1000>;
				interrupts = <0 0 0>,
					   <0 1 0>,
					   <0 2 0>,
					   <0 49 0>,
					   <0 50 0>,
					   <0 51 0>;
				clocks = <&clks 54>;
			};

			timerb@10dc8000 {
					compatible = "sirf,marco-tick";
					reg = <0x10dc8000 0x1000>;
					interrupts = <0 74 0>,
							   <0 75 0>,
							   <0 76 0>,
							   <0 77 0>,
							   <0 78 0>,
							   <0 79 0>;
					clocks = <&clks 54>;
			};

			dmac2: dma-controller@10d50000 {
				cell-index = <2>;
				compatible = "sirf,atlas7-dmac";
				reg = <0x10d50000 0xffff>;
				interrupts = <0 55 0>;
				#clocks = <&clks 25>;
				#dma-cells = <1>;
				#dma-channels = <16>;
			};

			dmac3: dma-controller@10d60000 {
				cell-index = <3>;
				compatible = "sirf,atlas7-dmac";
				reg = <0x10d60000 0xffff>;
				interrupts = <0 56 0>;
				#clocks = <&clks 24>;
				#dma-cells = <1>;
				#dma-channels = <16>;
			};
			audiom@10ED0000 {
				compatible = "sirf,nocfw-audiom";
				reg = <0x10ED0000 0x3000>;
				interrupts = <0 102 0>;
			};
		};

		ddrm {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x10820000 0x10820000 0x3000>;
			ddrm@10820000 {
				compatible = "sirf,nocfw-ddrm";
				reg = <0x10820000 0x3000>;
				interrupts = <0 105 0>;
			};
		};

		btm {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x11002000 0x11002000 0x0000ffff>,
				<0x11010000 0x11010000 0x3000>;

			dmac4: dma-controller@11002000 {
				cell-index = <4>;
				compatible = "sirf,atlas7-dmac";
				reg = <0x11002000 0x1000>;
				interrupts = <0 99 0>;
				#clocks = <&clks 25>;
				#dma-cells = <1>;
				#dma-channels = <16>;
			};
			btm@11010000 {
				compatible = "sirf,nocfw-btm";
				reg = <0x11010000 0x3000>;
			};
		};

		rtcm {
			compatible = "arteris, flexnoc", "simple-bus";
			ranges = <0x18810000 0x18810000 0x3000>;
			rtcm@18810000 {
				compatible = "sirf,nocfw-rtcm";
				reg = <0x18810000 0x3000>;
				interrupts = <0 109 0>;
			};
		};

	};
};
