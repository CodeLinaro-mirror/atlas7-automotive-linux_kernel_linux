/dts-v1/;

/include/ "atlas7.dtsi"

/ {
	model = "CSR SiRFatlas7 Evaluation Board";
	compatible = "sirf,atlas7-cb", "sirf,atlas7";

	chosen {
		bootargs = "console=ttySiRF1 earlyprintk lpj=7970816 clk_ignore_unused";
	};

	memory {
		device_type = "memory";
		reg = <0x50000000 0x10000000>; /* 256M for S */
	};

	noc {
		audiom {
			timer@10dc0000 {
				status = "okay";
			};
			timerb@10dc8000 {
				status = "disabled";
			};
		};

	        mediam {
                        sdhci@16000000 {
                                status = "okay";
                        };
                };

                vdifm {
                        sdhci@14200000 {
                                status = "okay";
                        };
                };

                gnssm {
                        uart1: uart@18020000 {
				status = "okay";
                        };

                        uart0: uart@18010000 {
				status = "disabled";
                        };
                };

	};
};
