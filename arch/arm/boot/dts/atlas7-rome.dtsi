/ {
	bt_sco_a2dp: bt-sco-a2dp {
		#sound-dai-cells = <0>;
		compatible = "bt-sco-a2dp";
		status = "disabled";
	};
/*
 * FIXME
 * Now pcm interface is used in android while i2s interface is used in linux
 * It is necessay to drop this workaround after i2s interface is used in android
 */
	sirf-bt-sco-a2dp {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,cpu {
			sound-dai = <&usp1>;
		};
		simple-audio-card,codec {
			sound-dai = <&bt_sco_a2dp>;
			bitclock-master;
			frame-master;
		};
	};
	noc {
		vdifm {
			sdhci@14300000 {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&sd3_pmx>;
				broken-cd;
			};
		};
		gnssm {
			uart4: uart@18050000 {
				status = "okay";
				pinctrl-0 = <&uart4_basic_pmx
						&uart4_cts_pmx2
						&uart4_rts_pmx2>;
				pinctrl-names = "default";
				sirf,uart-has-rtscts;
			};
			bt {
				compatible = "sirf,rome";
				/* PIN:coex_pio_0 */
				rome_gpio_1p8v_power = <&gpio_1 76 1>;
				/* PIN:coex_pio_1 */
				rome_gpio_3p3v_power = <&gpio_1 77 1>;
				/* PIN:coex_pio_2 */
				rome_gpio_bt_reset = <&gpio_1 78 1>;
				pinctrl-names = "default";
				pinctrl-0 = <&pw_i2s01_clk_pmx0>;
				pwms = <&pwm 6 30518>;
			};
		};
		audiom {
			usp1: usp@10d30000 {
				status = "okay";
				#sound-dai-cells = <0>;
				compatible = "sirf,prima2-usp-pcm";
				pinctrl-names = "default";
				pinctrl-0 = <&audio_uart1_basic_pmx
						&audio_uart1_urfs_pmx0>;
			};
		};
	};
};
